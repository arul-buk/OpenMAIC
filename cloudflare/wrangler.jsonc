{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmaic",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "routes": [
    {
      "pattern": "study.stayboba.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "OpenMAICContainer",
      "image": "../Dockerfile.cloudflare",
      "instance_type": "standard-2",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OPENMAIC_CONTAINER",
        "class_name": "OpenMAICContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OpenMAICContainer"]
    }
  ]
}
